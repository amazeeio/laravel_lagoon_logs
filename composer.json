{
    "name": "amazeeio/lagoon-logs",
    "description": "Zero config logging module for Laravel and Lagoon",
    "type": "package",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "monolog/monolog": "^3.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Blaize Kaye",
            "email": "blaize.kaye@amazee.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "amazeeio\\LagoonLogs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "amazeeio\\LagoonLogs\\LagoonLogsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.11.0"
    }
}
